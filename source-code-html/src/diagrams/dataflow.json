    {"id":"model-context","type":"backend","label":"模型上下文","sublabel":"messages 与 tools","stage":2,"row":1},
    {"id":"provider-stream","type":"cloud","label":"提供商请求","sublabel":"统一模型契约","stage":3,"row":1},
    {"id":"assistant-content","type":"frontend","label":"assistant","sublabel":"文本与工具调用","stage":4,"row":1},
    {"id":"prompt-resources","type":"backend","label":"提示与资源","sublabel":"系统提示、技能描述","stage":2,"row":0},
    {"id":"session-jsonl","type":"database","label":"会话 JSONL","sublabel":"持久会话追加日志","stage":1,"row":3},
